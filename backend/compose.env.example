# Environment for docker-compose.yml (NOT the app's .env).
# Copy to compose.env, then run:
#   docker compose --env-file compose.env up -d --build
#
# REQUIRED — generate your own 64-char random hex values:
#   openssl rand -hex 32
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SECRET_ENCRYPTION_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# --- App ---
APP_ENV=production
APP_PORT=8080
APP_DOMAIN=kilat-cloud.com
PUBLIC_API_BASE_URL=https://api.kilat-cloud.com
CONSOLE_BASE_URL=https://console.kilat-cloud.com
ADMIN_CONSOLE_BASE_URL=https://admin.kilat-cloud.com
DOWNLOAD_BASE_URL=https://dl.kilat-cloud.com
REQUEST_ID_HEADER=X-Request-ID
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTO_VERIFY_EMAIL=false
OTP_DEBUG_ECHO=false
SUBSCRIPTION_GRACE_DAYS=3
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
ARGON2_KEY_LENGTH=32
ARGON2_SALT_LENGTH=16

# --- Database / Redis / RustFS (local defaults; ports are host mappings) ---
POSTGRES_USER=kilat
POSTGRES_PASSWORD=kilat
POSTGRES_DB=kilat_cloud
POSTGRES_PORT=54329
REDIS_PORT=54389
RUSTFS_ACCESS_KEY=kilat
RUSTFS_SECRET_KEY=kilat-secret
RUSTFS_PORT=54390
RUSTFS_CONSOLE_PORT=54391

# --- Payment (SumoPod) ---
# Isi nilai nyata di compose.env (JANGAN commit secret). Placeholder di sini.
PAYMENT_PROVIDER=sumopod
PAYMENT_WEBHOOK_SECRET=change-me-40-char-random-hex
SUMOPOD_API_KEY=change-me
SUMOPOD_BASE_URL=https://api-pay.sumopod.com
SUMOPOD_WEBHOOK_SECRET=whsec_change_me
SUMOPOD_WEBHOOK_TOKEN=whtok_change_me

# --- Per-console API domains (audience scoping) ---
ADMIN_API_DOMAIN=https://api-admin.kilat-cloud.com
USER_API_DOMAIN=https://api-user.kilat-cloud.com
LANDING_API_DOMAIN=https://api-landing.kilat-cloud.com
DOCS_API_DOMAIN=https://api-docs.kilat-cloud.com

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://admin.kilat-cloud.com,https://console.kilat-cloud.com,https://kilat-cloud.com,https://landing.kilat-cloud.com,https://docs.kilat-cloud.com

# --- Object storage via RustFS (S3-compatible). Set automatically from
# --- RUSTFS_* above; override R2_* here only if you use external storage. ---
# R2_ENDPOINT=http://rustfs:9000
# R2_ACCESS_KEY=kilat
# R2_SECRET_KEY=kilat-secret
# R2_BUCKET=kilat-cloud-dev

# --- SMTP via Resend. API key diisi di compose.env (JANGAN commit key asli). ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=replace-with-your-resend-api-key
SMTP_FROM=noreply@kilat-cloud.com

# --- Cloudflare Tunnel (online-kan backend tanpa buka port publik) ---
# Isi token dari Zero Trust dashboard → Networks → Tunnels. Jangan commit ke git.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
