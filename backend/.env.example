# Kilat Cloud Backend — Environment configuration (PRODUCTION template)
# Copy to .env and fill in values. NEVER commit real secrets to git.
#
# For local development run: bash scripts/gen-env.sh
# For Docker deployment use compose.env (see compose.env.example).

# Application
APP_ENV=production
APP_PORT=8080
APP_DOMAIN=kilat-cloud.com

# PostgreSQL (source of truth). Applied via `make migrate`.
DATABASE_URL=postgres://kilat:kilat@localhost:54329/kilat_cloud?sslmode=disable

# Redis (sessions, OTP, rate limits, locks, hot cache)
REDIS_URL=redis://localhost:54389/0

# Auth / tokens — REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-64-char-random-hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# AES-256-GCM key-encryption-key for reversible secrets (TOTP seeds, API keys,
# webhook secrets). REQUIRED. Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=change-me-64-char-random-hex

# Argon2id password hashing parameters (tune via benchmark)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
ARGON2_KEY_LENGTH=32
ARGON2_SALT_LENGTH=16

# Public URLs used in emails, deep links, and WebAuthn RP origins
PUBLIC_API_BASE_URL=https://api.kilat-cloud.com
CONSOLE_BASE_URL=https://console.kilat-cloud.com
ADMIN_CONSOLE_BASE_URL=https://admin.kilat-cloud.com
DOWNLOAD_BASE_URL=https://dl.kilat-cloud.com
REQUEST_ID_HEADER=X-Request-ID

# Per-console API domains for audience scoping. The backend inspects the
# request Host and only serves each console its own endpoints:
#   api-admin.kilat-cloud.com   → /v1/admin/* + staff surfaces
#   api-user.kilat-cloud.com    → customer endpoints
#   api-landing.kilat-cloud.com → public marketing + media
#   api-docs.kilat-cloud.com    → public docs + media
# The generic api.kilat-cloud.com (and localhost) allow everything.
ADMIN_API_DOMAIN=https://api-admin.kilat-cloud.com
USER_API_DOMAIN=https://api-user.kilat-cloud.com
LANDING_API_DOMAIN=https://api-landing.kilat-cloud.com
DOCS_API_DOMAIN=https://api-docs.kilat-cloud.com

# OAuth — Google / GitHub (empty = provider disabled, login redirects with ?error=oauth_not_configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Onidel Cloud provider API (default compute provider; other providers plug in via internal/provider)
ONIDEL_BASE_URL=https://api.cloud.onidel.com
ONIDEL_API_KEY=

# Internal object storage (S3-compatible) — RustFS (self-hosted) by default.
# For `make up` RustFS listens on localhost:54390; inside Docker it is rustfs:9000.
R2_ENDPOINT=http://localhost:54390
R2_ACCESS_KEY=kilat
R2_SECRET_KEY=kilat-secret
R2_BUCKET=kilat-cloud

# RustFS (self-hosted S3) — used by Docker compose (see docker-compose.yml).
# These map into R2_* for the API container. Override R2_* directly only if
# you use external storage (Cloudflare R2 / S3 / MinIO).
RUSTFS_ACCESS_KEY=kilat
RUSTFS_SECRET_KEY=kilat-secret
RUSTFS_PORT=54390
RUSTFS_CONSOLE_PORT=54391

# Per-asset-category storage: each category (avatar, document, iso, ticket,
# invoice) gets its OWN bucket/endpoint/credentials via rows in
# object_storage_backends, managed by admins at /v1/admin/storage-backends
# (credentials encrypted at rest). Rows with empty endpoint/credentials
# inherit the global R2_* values above.

# SMTP for transactional email (verification, password reset, invoices).
# Production: Resend — host smtp.resend.com, user resend, password = Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_api_key
SMTP_FROM=noreply@kilat-cloud.com

# Payment gateway (midtrans or sumopod). REQUIRED PAYMENT_WEBHOOK_SECRET.
PAYMENT_PROVIDER=sumopod
PAYMENT_WEBHOOK_SECRET=change-me-40-char-random-hex
# SumoPod (https://api-pay.sumopod.com) — PT KILAT CLOUD INDONESIA project.
# API key from Settings → API Key. Webhook:
#   https://<PUBLIC_API_BASE_URL>/v1/payments/webhook in SumoPod Settings → Webhook URL,
# then copy signing secret (whsec_...) and/or webhook token (whtok_...) here.
SUMOPOD_API_KEY=change-me
SUMOPOD_BASE_URL=https://api-pay.sumopod.com
SUMOPOD_WEBHOOK_SECRET=whsec_change_me
SUMOPOD_WEBHOOK_TOKEN=whtok_change_me

# Subscriptions
SUBSCRIPTION_GRACE_DAYS=3

# CORS allowed origins (comma-separated). Empty = defaults to known Kilat Cloud domains.
CORS_ALLOWED_ORIGINS=https://admin.kilat-cloud.com,https://console.kilat-cloud.com,https://kilat-cloud.com,https://landing.kilat-cloud.com,https://docs.kilat-cloud.com

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20

# Development conveniences — NEVER enable in production:
#   AUTO_VERIFY_EMAIL=true marks e-mail verified at registration when SMTP is not configured.
#   OTP_DEBUG_ECHO=true returns phone OTP codes in API responses instead of sending SMS.
AUTO_VERIFY_EMAIL=false
OTP_DEBUG_ECHO=false
