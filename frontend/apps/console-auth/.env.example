# Kilat Cloud Auth Console — Environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.

# Application
VITE_APP_TITLE=Kilat Cloud Auth
VITE_APP_DOMAIN=auth.kilat-cloud.com

# API base URL (all-audience API so both user + staff endpoints are reachable).
# In dev the Vite dev server proxies /api -> http://localhost:8080.
VITE_API_BASE_URL=https://api-auth.kilat-cloud.com
VITE_PORT=5175

# Where the auth console sends the user after sign-in, by role.
VITE_CUSTOMER_CONSOLE_URL=https://console.kilat-cloud.com
VITE_ADMIN_CONSOLE_URL=https://admin.kilat-cloud.com

VITE_DOWNLOAD_BASE_URL=https://dl.kilat-cloud.com

# Correlation header echoed on responses (debugging).
VITE_REQUEST_ID_HEADER=X-Request-ID
