# Kilat Cloud Admin Console — Environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.
# For local dev you can also run: bash scripts/gen-frontend-env.sh

# Application
VITE_APP_TITLE=Kilat Cloud Admin
VITE_APP_DOMAIN=admin.kilat-cloud.com

# API base URL. In dev the Vite dev server proxies /api -> http://localhost:8080,
# so this is only used outside Vite dev (e.g. a built preview or separate host).
VITE_API_BASE_URL=https://api-admin.kilat-cloud.com
VITE_PORT=5173

# This console's own base URL (used in emails, deep links and WebAuthn origin).
VITE_CONSOLE_BASE_URL=https://admin.kilat-cloud.com
VITE_DOWNLOAD_BASE_URL=https://dl.kilat-cloud.com

# Correlation header echoed on responses (debugging).
VITE_REQUEST_ID_HEADER=X-Request-ID
